// File name: projects/3/a/RAM8.hdl
/**
 * Memory of eight 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    DMux8Way(in=load , sel=address, a=load0 , b=load1 , c=load2 , d=load3 , e=load4 , f=load5 , g=load6 , h=load7 );
    Register(in=in , load=load0 , out=registarOut1 );
    Register(in=in , load=load1 , out=registarOut2 );
    Register(in=in , load=load2 , out=registarOut3 );
    Register(in=in , load=load3 , out=registarOut4 );
    Register(in=in , load=load4 , out=registarOut5 );
    Register(in=in , load=load5 , out=registarOut6 );
    Register(in=in , load=load6 , out=registarOut7 );
    Register(in=in , load=load7 , out=registarOut8 );

    Mux8Way16(a=registarOut1 , b=registarOut2 , c=registarOut3 , d=registarOut4 , e=registarOut5 , f=registarOut6 , g=registarOut7 , h=registarOut8 , sel=address , out=out );

}